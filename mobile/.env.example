# Copy to `.env` for local development. Expo inlines EXPO_PUBLIC_* vars at build
# time and exposes them on process.env (see src/config/env.ts).

# Base URL of the Sakina backend API.
# Android emulator -> host machine: http://10.0.2.2:8000 (default)
# iOS simulator:                     http://localhost:8000
# Physical device:                   http://<your-LAN-IP>:8000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Show the developer/QA tools (RingerControl panel + API/device footer in
# Settings) in a *bundled* build. Debug builds always show them; this opt-in is
# for standalone testing APKs. Set to 1 only when building a testing/QA APK —
# leave it unset (or 0) for release/production so the dev tools never ship.
#   EXPO_PUBLIC_SHOW_DEV_TOOLS=1
