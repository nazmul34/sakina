<!--
  Status-bar icon for auto-silent failure warnings (FR-1.9).

  A filled warning triangle — the universal "something needs your attention"
  glyph, legible at status-bar size. White, 24dp; Android masks status-bar icons
  by alpha, so only the shape matters.

  Lives in the module's own res/ (not the app's android/res/) so it ships in the
  module AAR and survives `expo prebuild`, which regenerates android/.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M1,21h22L12,2 1,21zM13,18h-2v-2h2v2zM13,14h-2v-4h2v4z"/>
</vector>
