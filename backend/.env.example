# Copy this file to `.env` and adjust for your local environment.
# These values are read by config/settings/*.py via django-environ.

# Which settings module to load. Defaults to config.settings.dev locally
# (set in manage.py / wsgi.py / asgi.py). Use config.settings.prod in
# production. You normally only set this in deployment, not in a local .env.
# DJANGO_SETTINGS_MODULE=config.settings.dev

# Set to True for local development only. NEVER True in production.
# (prod settings force DEBUG=False regardless of this value.)
DEBUG=True

# Generate a real secret for any non-local deployment, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The prod settings refuse to boot if this is left as the insecure default.
SECRET_KEY=dev-insecure-secret-key-change-me

# Comma-separated list of allowed hosts (no spaces).
# Required and must be non-wildcard in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave unset to use the local SQLite default (db.sqlite3).
# For Postgres (e.g. docker-compose), use:
# DATABASE_URL=postgres://sakina:sakina@localhost:5432/sakina
# DATABASE_URL=

# CORS. In dev, allowing all origins is convenient.
# Prod settings force CORS_ALLOW_ALL_ORIGINS=False; provide an explicit
# allowlist via CORS_ALLOWED_ORIGINS instead.
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# ---------------------------------------------------------------------------
# Geoapify Places — nearby-mosque source (EPIC-02, FR-2.5)
# ---------------------------------------------------------------------------
# Server-side only; never exposed to the client. Create a key at geoapify.com.
# The /mosques endpoint returns 502 until this is set. Once deployed, restrict
# the key to the server's IP in the Geoapify dashboard.
GEOAPIFY_API_KEY=
# Outbound request timeout in seconds (FR-2.3 budget). Default 15.
# GEOAPIFY_TIMEOUT_S=15

# Overpass — keyless OSM fallback used when Geoapify fails / is over quota.
# Needs no key; override only if you run a private Overpass instance.
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# OVERPASS_TIMEOUT_S=25

# Nearby-mosque search radius in metres (FR-2.1). Fixed server-side; the client
# never controls it. Default 5000 (~5 km, matched to the #47 tile). Override to
# retune coverage without shipping a new app build.
# MOSQUE_SEARCH_RADIUS_M=5000

# ---------------------------------------------------------------------------
# Production-only TLS/security tuning (config.settings.prod). Sensible defaults
# are applied automatically; override only if a host needs it.
# ---------------------------------------------------------------------------
# Redirect all HTTP requests to HTTPS (default True in prod).
# SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds (default 31536000 = 1 year). Set 0 to disable while
# bringing a host up before TLS is guaranteed.
# SECURE_HSTS_SECONDS=31536000
