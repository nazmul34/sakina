# Production environment for docker-compose.prod.yml.
# Copy to .env.prod and fill in. NEVER commit the real .env.prod.

# --- Django ---------------------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-random-value
DEBUG=False
# Must be your public hostname, no wildcard (prod settings reject "*").
ALLOWED_HOSTS=sakina.duckdns.org
# Needed only if you use the Django admin over HTTPS.
CSRF_TRUSTED_ORIGINS=https://sakina.duckdns.org
# The mobile app is native, not a browser origin, so CORS can stay empty.
CORS_ALLOWED_ORIGINS=
# TLS is terminated by Caddy and forwarded via X-Forwarded-Proto, so keep this on.
SECURE_SSL_REDIRECT=True

# --- Public hostname + TLS (Caddy) ---------------------------------------
DOMAIN=sakina.duckdns.org
ACME_EMAIL=you@example.com

# --- Cloudflare R2 backups (Litestream), S3-compatible -------------------
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=sakina-db-backups
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
